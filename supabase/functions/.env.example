# Configure em Supabase > Edge Functions > Secrets. Nunca no frontend.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são fornecidos pela plataforma.
APP_URL=https://SEU-SITE.pages.dev/
MP_ACCESS_TOKEN=COLOQUE_O_ACCESS_TOKEN_PRIVADO
MP_WEBHOOK_SECRET=COLOQUE_A_ASSINATURA_SECRETA
MP_COLLECTOR_ID=COLOQUE_O_ID_DA_CONTA_RECEBEDORA
MP_LIVE_MODE=false
# Só habilite depois de testar conta, cobrança, renovação e cancelamento.
BILLING_ENABLED=false
